<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VtmTool.UI.TraitEditDialog"
        Title="Trait"
        Width="400" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a"
        Foreground="#e0e0e0"
        FontFamily="Consolas,Courier New,monospace">

	<Window.Styles>
		<Style Selector="TextBlock.lbl">
			<Setter Property="Foreground" Value="#aaa"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Margin" Value="0,8,0,2"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="#222"/>
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Background" Value="#222"/>
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</Window.Styles>

	<StackPanel Margin="24" Spacing="0">

		<!-- Name -->
		<TextBlock Classes="lbl" Text="Name"/>
		<ComboBox x:Name="NameBox"
                  HorizontalAlignment="Stretch"
                  IsEditable="True"/>

		<!-- Rating -->
		<TextBlock Classes="lbl" Text="Rating (0 = unrated)"/>
		<StackPanel x:Name="RatingPicker"
                    Orientation="Horizontal"
                    Spacing="4"/>

		<!-- Detail -->
		<TextBlock Classes="lbl" Text="Detail (optional)"/>
		<TextBox x:Name="DetailBox"
                 Watermark="e.g. Warehouse in the Docks"
                 HorizontalAlignment="Stretch"/>

		<!-- Buttons -->
		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
			<Button Content="Cancel"
                    Background="#2a2a2a"
                    Foreground="#e0e0e0"
                    BorderBrush="#444"
                    Padding="14,7"
                    Click="OnCancel"/>
			<Button Content="Save"
                    Background="#5a0000"
                    Foreground="#fff"
                    BorderBrush="#900000"
                    Padding="14,7"
                    Click="OnSave"/>
		</StackPanel>

	</StackPanel>
</Window>