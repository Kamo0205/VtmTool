<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VtmTool.UI"
        x:Class="VtmTool.UI.MainWindow"
        Title="VtM V5 — Character Tool"
        Width="1340" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1a1a1a">

	<Window.Styles>
		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="TextBlock.section">
			<Setter Property="Foreground" Value="#b00000"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="LetterSpacing" Value="2"/>
			<Setter Property="Margin" Value="0,12,0,4"/>
		</Style>
		<Style Selector="TextBlock.charName">
			<Setter Property="Foreground" Value="#ffffff"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="TextBlock.subtitle">
			<Setter Property="Foreground" Value="#999"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,2,0,0"/>
		</Style>
		<Style Selector="Button.charItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.charItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2a2a2a"/>
		</Style>
		<Style Selector="Button.charItem.selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#2e0000"/>
		</Style>
		<Style Selector="Button.action">
			<Setter Property="Background" Value="#2a0000"/>
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="BorderBrush" Value="#5a0000"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,7"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.action:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#3d0000"/>
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#5a0000"/>
			<Setter Property="Foreground" Value="#ffffff"/>
			<Setter Property="BorderBrush" Value="#900000"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Button.primary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#750000"/>
		</Style>
		<Style Selector="TextBlock.statLabel">
			<Setter Property="Foreground" Value="#aaa"/>
			<Setter Property="Width" Value="110"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
		<Style Selector="TextBlock.dots">
			<Setter Property="Foreground" Value="#cc2200"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.track">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
		</Style>
		<Style Selector="TextBlock.hunger">
			<Setter Property="Foreground" Value="#cc0000"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="TextBlock.placeholder">
			<Setter Property="Foreground" Value="#444"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="NumericUpDown /template/ TextBox">
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</Window.Styles>

	<!-- Three columns: sidebar | sheet | roller -->
	<Grid ColumnDefinitions="220,1,*,1,300">

		<!-- ── LEFT SIDEBAR ─────────────────────────────────── -->
		<DockPanel Grid.Column="0" Background="#111">
			<Button Classes="primary"
                    DockPanel.Dock="Top"
                    Margin="10,10,10,4"
                    Click="OnNewCharacter">
				+ New Character
			</Button>
			<Separator DockPanel.Dock="Top" Margin="10,4" Background="#2a2a2a" Height="1"/>
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="CharacterList" Spacing="1"/>
			</ScrollViewer>
		</DockPanel>

		<Rectangle Grid.Column="1" Fill="#2a2a2a"/>

		<!-- ── CHARACTER SHEET ──────────────────────────────── -->
		<Grid Grid.Column="2">

			<TextBlock x:Name="EmptyState" Classes="placeholder" Text="Select or create a character"/>

			<Grid x:Name="SheetPanel" IsVisible="False" RowDefinitions="*,Auto,Auto,Auto">
				<DockPanel Grid.Row="0" Margin="24,20,24,0">
					<!-- Action toolbar -->
					<WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
						<Button Classes="action" Margin="0,0,6,6" Click="OnRouse">Rouse Check</Button>
						<Button Classes="action" Margin="0,0,6,6" Click="OnDamage">Apply Damage</Button>
						<Button Classes="action" Margin="0,0,6,6" Click="OnHeal">Heal</Button>
						<Button Classes="action" Margin="0,0,6,6" Click="OnEditAttr">Edit Attributes</Button>
						<Button Classes="action" Margin="0,0,6,6" Click="OnEditSkills">Edit Skills</Button>
						<Button Classes="action" Margin="0,0,6,6" Click="OnEditDisciplines">Edit Disciplines</Button>
						<Button Classes="action" Margin="0,0,0,6" Click="OnDelete">Delete</Button>
					</WrapPanel>

					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="0">

							<TextBlock x:Name="SheetName" Classes="charName"/>
							<TextBlock x:Name="SheetSubtitle" Classes="subtitle"/>
							<TextBlock x:Name="SheetBloodPotency" Classes="subtitle" Margin="0,2,0,0"/>
							<TextBlock x:Name="SheetPredatorType" Classes="subtitle" Margin="0,2,0,0"/>

							<TextBlock Classes="section" Text="ATTRIBUTES"/>
							<!-- Attribute columns rebuilt dynamically in RefreshSheet -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel x:Name="AttrPhysicalPanel" Grid.Column="0" Spacing="3"/>
								<StackPanel x:Name="AttrSocialPanel"   Grid.Column="1" Spacing="3"/>
								<StackPanel x:Name="AttrMentalPanel"   Grid.Column="2" Spacing="3"/>
							</Grid>

							<TextBlock Classes="section" Text="SKILLS"/>
							<!-- Skill columns rebuilt dynamically in RefreshSheet -->
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel x:Name="SkillPhysicalPanel" Grid.Column="0" Spacing="3"/>
								<StackPanel x:Name="SkillSocialPanel"   Grid.Column="1" Spacing="3"/>
								<StackPanel x:Name="SkillMentalPanel"   Grid.Column="2" Spacing="3"/>
							</Grid>

							<TextBlock Classes="section" Text="DISCIPLINES"/>
							<StackPanel x:Name="DisciplinePanel" Spacing="6"/>

							<TextBlock Classes="section" Text="SPECIALTIES"/>
							<StackPanel x:Name="SpecialtiesPanel" Spacing="3"/>

							<TextBlock Classes="section" Text="HEALTH &amp; WILLPOWER"/>
							<StackPanel Spacing="6">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Classes="statLabel" Text="Health"/>
									<TextBlock x:Name="TrackHealth" Classes="track"/>
									<TextBlock x:Name="WoundPenalty" Foreground="#cc0000" FontSize="12" VerticalAlignment="Center"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock Classes="statLabel" Text="Willpower"/>
									<TextBlock x:Name="TrackWillpower" Classes="track"/>
								</StackPanel>
							</StackPanel>

							<TextBlock Classes="section" Text="HUNGER"/>
							<TextBlock x:Name="TrackHunger" Classes="hunger"/>

							<TextBlock x:Name="StatusMsg"
									   Foreground="#888"
									   FontSize="12"
									   Margin="0,14,0,0"
									   TextWrapping="Wrap"/>

						</StackPanel>
					</ScrollViewer>
				</DockPanel>
				<ui:NotesPanel x:Name="NotesPanel" Grid.Row="1" Margin="24,0,24,12"/>
				<ui:XpPanel x:Name="XpPanel" Grid.Row="2" Margin="24,0,24,12"/>
				<ui:TraitsPanel x:Name="TraitsPanel" Grid.Row="3" Margin="24,0,24,12"/>
			</Grid>
		</Grid>

		<Rectangle Grid.Column="3" Fill="#2a2a2a"/>

		<!-- ── DICE ROLLER PANEL ─────────────────────────────── -->
		<ui:DiceRollerPanel x:Name="Roller" Grid.Column="4"/>

	</Grid>
</Window>