<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VtmTool.UI.ConfirmDialog"
        Title="Confirm"
        Width="320" Height="148"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#161616"
        Foreground="#e0e0e0"
        FontFamily="Consolas,Courier New,monospace">

	<Border BorderBrush="#2a2a2a" BorderThickness="0,2,0,0">
		<StackPanel Margin="24,20,24,20" Spacing="20">

			<TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="#d0d0d0"/>

			<StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">

				<Button Content="Cancel"
                        Background="#1e1e1e"
                        Foreground="#888"
                        BorderBrush="#2a2a2a"
                        BorderThickness="1"
                        Padding="16,8"
                        CornerRadius="4"
                        Click="OnCancel"/>

				<Button Content="Delete"
                        Background="#5a0000"
                        Foreground="#fff"
                        BorderBrush="#7a0000"
                        BorderThickness="1"
                        Padding="16,8"
                        CornerRadius="4"
                        Click="OnConfirm"/>

			</StackPanel>
		</StackPanel>
	</Border>

</Window>