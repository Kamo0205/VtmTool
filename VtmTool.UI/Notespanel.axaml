<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VtmTool.UI.NotesPanel"
             Background="#0f0f0f">

	<UserControl.Styles>

		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="#c0c0c0"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style Selector="TabItem">
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Foreground" Value="#555"/>
			<Setter Property="Padding" Value="12,6"/>
			<!--<Setter Property="LetterSpacing" Value="1"/>-->
		</Style>
		<Style Selector="TabItem:selected">
			<Setter Property="Foreground" Value="#c0c0c0"/>
		</Style>

		<Style Selector="TextBox.notes">
			<Setter Property="Background" Value="#0a0a0a"/>
			<Setter Property="Foreground" Value="#c0c0c0"/>
			<Setter Property="BorderBrush" Value="#222"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="AcceptsReturn" Value="True"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="MinHeight" Value="100"/>
			<Setter Property="CornerRadius" Value="3"/>
		</Style>

		<Style Selector="Button.saveNotes">
			<Setter Property="Background" Value="#1e1e1e"/>
			<Setter Property="Foreground" Value="#888"/>
			<Setter Property="BorderBrush" Value="#333"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,6"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="Button.saveNotes:enabled">
			<Setter Property="Background" Value="#2a0000"/>
			<Setter Property="Foreground" Value="#e0e0e0"/>
			<Setter Property="BorderBrush" Value="#5a0000"/>
		</Style>
		<Style Selector="Button.saveNotes:enabled:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#3d0000"/>
		</Style>
		<Style Selector="Button.saveNotes:disabled /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.3"/>
		</Style>

	</UserControl.Styles>

	<StackPanel>

		<!-- Header bar — distinct from XP and Traits -->
		<Expander x:Name="NotesExpander"
                  IsExpanded="False"
                  Background="Transparent"
                  BorderBrush="#1e1e1e"
                  BorderThickness="0,1,0,0"
                  Padding="0">

			<Expander.Header>
				<StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0">
					<!-- Small icon accent -->
					<Border Width="3" Height="14"
                            Background="#c00000"
                            VerticalAlignment="Center"
                            CornerRadius="1"/>
					<TextBlock Text="NOTES"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#888"
                               LetterSpacing="3"
                               VerticalAlignment="Center"
                               Margin="0,10,0,10"/>
				</StackPanel>
			</Expander.Header>

			<StackPanel Margin="28,8,28,16" Spacing="0">

				<TabControl Background="Transparent" BorderThickness="0">

					<TabItem Header="BACKGROUND">
						<TextBox x:Name="BackgroundBox"
                                 Classes="notes"
                                 Watermark="Before the Embrace. Early unlife. Key memories."/>
					</TabItem>

					<TabItem Header="GOALS">
						<TextBox x:Name="GoalsBox"
                                 Classes="notes"
                                 Watermark="Ambitions. Current hunts. Long-term schemes."/>
					</TabItem>

					<TabItem Header="COTERIE">
						<TextBox x:Name="CoterieBox"
                                 Classes="notes"
                                 Watermark="Coterie. Allies. Enemies. Sire. Sect ties."/>
					</TabItem>

				</TabControl>

				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12"
                            Margin="0,8,0,0">
					<TextBlock x:Name="SaveStatus"
                               Foreground="#444"
                               FontSize="10"
                               VerticalAlignment="Center"/>
					<Button Classes="saveNotes"
                            x:Name="SaveBtn"
                            Content="Save Notes"
                            IsEnabled="False"
                            Click="OnSave"/>
				</StackPanel>

			</StackPanel>

		</Expander>

	</StackPanel>

</UserControl>