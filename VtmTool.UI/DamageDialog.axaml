<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VtmTool.UI.DamageDialog"
        Title="Damage"
        Width="320" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#161616"
        Foreground="#e0e0e0"
        FontFamily="Consolas,Courier New,monospace">

	<Border BorderBrush="#2a2a2a" BorderThickness="0,2,0,0">
		<StackPanel Margin="24,16,24,20" Spacing="12">

			<TextBlock x:Name="DialogTitle"
                       FontSize="13"
                       FontWeight="Bold"
                       LetterSpacing="1"
                       Foreground="#c00000"/>

			<!-- Track -->
			<StackPanel Spacing="4">
				<TextBlock Text="TRACK"
                           FontSize="9"
                           Foreground="#444"
                           LetterSpacing="2"/>
				<ComboBox x:Name="TrackBox"
                          HorizontalAlignment="Stretch"
                          Background="#0e0e0e"
                          Foreground="#e0e0e0"
                          BorderBrush="#2a2a2a"
                          CornerRadius="4">
					<ComboBoxItem Content="Health"    Tag="health"/>
					<ComboBoxItem Content="Willpower" Tag="willpower"/>
				</ComboBox>
			</StackPanel>

			<!-- Type -->
			<StackPanel Spacing="4">
				<TextBlock x:Name="TypeLabel"
                           Text="TYPE"
                           FontSize="9"
                           Foreground="#444"
                           LetterSpacing="2"/>
				<ComboBox x:Name="TypeBox"
                          HorizontalAlignment="Stretch"
                          Background="#0e0e0e"
                          Foreground="#e0e0e0"
                          BorderBrush="#2a2a2a"
                          CornerRadius="4"/>
			</StackPanel>

			<!-- Amount -->
			<StackPanel Spacing="4">
				<TextBlock Text="AMOUNT"
                           FontSize="9"
                           Foreground="#444"
                           LetterSpacing="2"/>
				<NumericUpDown x:Name="AmountBox"
                               Minimum="1" Maximum="10" Value="1"
                               HorizontalAlignment="Stretch"
                               Background="#0e0e0e"
                               Foreground="#e0e0e0"
                               BorderBrush="#2a2a2a"/>
			</StackPanel>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
				<Button Content="Cancel"
                        Background="#1e1e1e"
                        Foreground="#888"
                        BorderBrush="#2a2a2a"
                        BorderThickness="1"
                        Padding="16,8"
                        CornerRadius="4"
                        Click="OnCancel"/>
				<Button Content="Confirm"
                        Background="#5a0000"
                        Foreground="#fff"
                        BorderBrush="#7a0000"
                        BorderThickness="1"
                        Padding="16,8"
                        CornerRadius="4"
                        Click="OnConfirm"/>
			</StackPanel>

		</StackPanel>
	</Border>

</Window>