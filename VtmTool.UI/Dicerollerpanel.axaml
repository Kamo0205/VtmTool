<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="VtmTool.UI.DiceRollerPanel"
			 Background="#0e0e0e">
	<UserControl.Styles>

		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="#c0c0c0"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style Selector="TextBlock.rollerHeader">
			<Setter Property="Foreground" Value="#c00000"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="LetterSpacing" Value="3"/>
			<Setter Property="Margin" Value="0,12,0,4"/>
		</Style>

		<Style Selector="TextBlock.poolTotal">
			<Setter Property="Foreground" Value="#ffffff"/>
			<Setter Property="FontSize" Value="32"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<Style Selector="TextBlock.poolLabel">
			<Setter Property="Foreground" Value="#555"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style Selector="TextBlock.fieldLabel">
			<Setter Property="Foreground" Value="#444"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="LetterSpacing" Value="1"/>
			<Setter Property="Margin" Value="0,8,0,2"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="Background" Value="#161616"/>
			<Setter Property="Foreground" Value="#c0c0c0"/>
			<Setter Property="BorderBrush" Value="#2a2a2a"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>

		<!-- Roll button — bold, full width, distinct -->
		<Style Selector="Button.roll">
			<Setter Property="Background" Value="#6e0000"/>
			<Setter Property="Foreground" Value="#ffffff"/>
			<Setter Property="BorderBrush" Value="#8a0000"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<!--<Setter Property="LetterSpacing" Value="2"/>-->
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0,12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="Button.roll:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#880000"/>
		</Style>
		<Style Selector="Button.roll:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#500000"/>
		</Style>
		<Style Selector="Button.roll:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="#1a1a1a"/>
			<Setter Property="Opacity" Value="0.4"/>
		</Style>

		<!-- Small +/- buttons -->
		<Style Selector="Button.nudge">
			<Setter Property="Background" Value="#1a1a1a"/>
			<Setter Property="Foreground" Value="#888"/>
			<Setter Property="BorderBrush" Value="#2a2a2a"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Width" Value="32"/>
		</Style>
		<Style Selector="Button.nudge:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2a0000"/>
			<Setter Property="Foreground" Value="#cc2200"/>
		</Style>

		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="#666"/>
			<Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>
		<Style Selector="CheckBox:checked">
			<Setter Property="Foreground" Value="#c00000"/>
		</Style>

	</UserControl.Styles>
	<DockPanel>
		<Rectangle DockPanel.Dock="Top" Height="2" Fill="#2a0000"/>
		<DockPanel Margin="16,12,16,16">

		<!-- ── POOL BUILDER ─────────────────────────────────────── -->
		<StackPanel DockPanel.Dock="Top" Spacing="0">

			<TextBlock Classes="rollerHeader" Text="DICE POOL"/>

			<TextBlock Classes="fieldLabel" Text="ATTRIBUTE"/>
			<ComboBox x:Name="AttrBox"
					  HorizontalAlignment="Stretch"
					  SelectionChanged="OnSelectionChanged"/>

			<TextBlock Classes="fieldLabel" Text="SKILL"/>
			<ComboBox x:Name="SkillBox"
					  HorizontalAlignment="Stretch"
					  SelectionChanged="OnSelectionChanged"/>

			<!-- Modifier row -->
			<Grid ColumnDefinitions="*,8,Auto,4,Auto" Margin="0,10,0,0">
				<TextBlock Grid.Column="0"
						   Text="MODIFIER"
						   Classes="fieldLabel"
						   VerticalAlignment="Center"
						   Margin="0"/>
				<Button Grid.Column="2" Classes="nudge" Content="−" Click="OnModDown"/>
				<Button Grid.Column="4" Classes="nudge" Content="+" Click="OnModUp"/>
			</Grid>
			<TextBlock x:Name="ModLabel"
					   Text="+0"
					   Foreground="#c00000"
					   FontSize="12"
					   FontWeight="Bold"
					   Margin="0,2,0,0"/>

			<CheckBox x:Name="WillpowerCheck"
                          Content="Spend Willpower  (+3 dice)"
                          Margin="0,10,0,0"
                          IsCheckedChanged="OnCheckedChanged"/>

			<TextBlock x:Name="WoundNote"
                           Text=""
                           Foreground="#c00000"
                           FontSize="10"
                           Margin="0,4,0,0"/>

			<!-- Pool total display -->
			<Border Background="#0a0a0a"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
					CornerRadius="4"
                    Margin="0,12,0,0"
                    Padding="14,10">
				<Grid ColumnDefinitions="Auto,*">
					<TextBlock x:Name="PoolTotalLabel"
							   Grid.Column="0"
							   Classes="poolTotal"
							   Text="—"
							   VerticalAlignment="Center"/>
					<StackPanel Grid.Column="1"
								Margin="14,0,0,0"
								VerticalAlignment="Center">
						<TextBlock Text="DICE"
								   Foreground="#2a2a2a"
								   FontSize="9"
								   LetterSpacing="2"/>
						<TextBlock x:Name="PoolBreakdownLabel"
								   Classes="poolLabel"
								   Text="select attribute + skill"/>
					</StackPanel>
				</Grid>
			</Border>

			<Grid ColumnDefinitions="*,8,Auto,4,Auto" Margin="0,10,0,0">
				<TextBlock Grid.Column="0"
						   Text="DIFFICULTY"
						   Classes="fieldLabel"
						   VerticalAlignment="Center"
						   Margin="0"/>
				<Button Grid.Column="2" Classes="nudge" Content="−" Click="OnDiffDown"/>
				<Button Grid.Column="4" Classes="nudge" Content="+" Click="OnDiffUp"/>
			</Grid>
			<TextBlock x:Name="DiffLabel"
					   Text="1"
					   Foreground="#888"
					   FontSize="11"
					   Margin="0,2,0,10"/>

			<Button Classes="roll"
                        x:Name="RollBtn"
                        Content="ROLL"
                        Click="OnRoll"/>

		</StackPanel>

		<TextBlock DockPanel.Dock="Top"
						Classes="rollerHeader"
						Text="RESULTS"/>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="HistoryPanel" Spacing="8"/>
		</ScrollViewer>

	</DockPanel>
	</DockPanel>
</UserControl>